// Modelo local revisado: users/{uid} guarda orçamento opcional; goals/{id}
// guarda meta ativa/arquivada; contributions/{id} guarda aporte monetário e data.
// UID é o caminho proprietário. Ausência de status em dados antigos significa ativa.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validUser(m) { return m.get('monthlyBudget', 0) is number && m.get('monthlyBudget', 0) >= 0 && m.get('monthlyBudget', 0) <= 10000000000; }
  function validGoal(m) {
   return m.keys().hasOnly(['title','total','saved','monthly','prio','publico','specs','img','category','startMonth','deadline','status','archivedAt','createdAt'])
    && m.title is string && m.title.size() > 0 && m.title.size() <= 120
    && m.total is number && m.total > 0 && m.total <= 10000000000
    && m.saved is number && m.saved >= 0 && m.saved <= m.total
    && m.get('monthly',0) is number && m.get('monthly',0) >= 0 && m.get('monthly',0) <= 10000000000
    && m.prio is int && m.prio >= 1 && m.prio <= 1000000
    && m.get('publico',false) is bool && m.get('status','active') in ['active','archived']
    && m.get('img','') is string && m.get('img','').size() <= 900000
    && m.get('category','outro') is string && m.get('category','outro').size() <= 30
    && m.get('startMonth','') is string && (m.get('startMonth','') == '' || m.startMonth.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])'))
    && m.get('deadline','') is string && (m.get('deadline','') == '' || m.deadline.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])'))
    && (m.get('archivedAt',null) == null || (m.archivedAt is string && m.archivedAt.size() <= 35))
    && (!('createdAt' in m) || m.createdAt is timestamp || (m.createdAt is string && m.createdAt.size() <= 35))
    && validSpecs(m.get('specs',[]));
  }
  // Estrutura de detalhes herdada: preservada para compatibilidade com metas antigas.
  function validSpecs(s) { return s is list && s.size() <= 30; }
  function validContribution(m) { return m.keys().hasOnly(['amount','total','date']) && m.amount is number && m.amount > 0 && m.amount <= 10000000000 && m.total is number && m.total >= 0 && m.total <= 10000000000 && m.date is timestamp; }
  match /users/{uid} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid) && validUser(request.resource.data);
   match /goals/{goal} {
    allow get: if owner(uid) || resource.data.get('publico',false) == true;
    allow list, delete: if owner(uid);
    allow create, update: if owner(uid) && validGoal(request.resource.data);
    match /contributions/{contribution} {
     allow read, delete: if owner(uid);
     allow create, update: if owner(uid) && validContribution(request.resource.data) && getAfter(/databases/$(database)/documents/users/$(uid)/goals/$(goal)).data.title is string;
    }
   }
  }
 }
}
